{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "capabilityId"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "capabilityId": {
      "const": "markitdown"
    },
    "markdown": {
      "type": "string"
    },
    "markdownChars": {
      "type": "integer",
      "minimum": 0,
      "description": "Character count of markdown produced by markitdown."
    },
    "outputPath": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "error": {
      "type": "string"
    }
  }
}
